# Console
CONSOLE_ADDR=127.0.0.1:8787
CONSOLE_DB=sqlite:data/console.db
CONSOLE_APP_NAME=doggy-dns-console
CONSOLE_USER_ID=local
# 1 = fixture data + scripted model, no external services
CONSOLE_DEMO=0

# OpenObserve REST (dashboard)
OPENOBSERVE_BASE_URL=http://127.0.0.1:5080
OPENOBSERVE_ORG=default
OPENOBSERVE_USER=root@example.com
OPENOBSERVE_PASSWORD=change-me
# Optional bearer token; takes precedence over basic auth
OPENOBSERVE_TOKEN=
OPENOBSERVE_LOG_STREAM=doggy_dns
OPENOBSERVE_TRACE_STREAM=doggy_dns
# Counter metric used for discovery and the overview query rate
OPENOBSERVE_METRIC_QUERIES=dns_queries
# Histogram metric used for query latency
OPENOBSERVE_METRIC_DURATION=dns_query_duration_bucket

# OpenObserve MCP (AI raw drill-down, read-only allowlist)
OPENOBSERVE_MCP_URL=http://127.0.0.1:5080/api/default/mcp
OPENOBSERVE_MCP_TOKEN=

# doggy-dns discovery: instances are discovered from OpenObserve telemetry
# (host.name + doggy_dns.ip_addr/control.port, stored as host_name,
# doggy_dns_ip_addr, doggy_dns_control_port). When a node publishes no control
# endpoint, the console assumes http://{host}:{MCP_CONTROL_PORT}/mcp.
MCP_CONTROL_PORT=19090
# Optional static endpoints (comma separated); probed in addition to discovery
MCP_ENDPOINTS=
# Bearer token for every doggy-dns /mcp endpoint (control.token)
MCP_TOKEN=

# Model (OpenAI-compatible). MODEL_BASE_URL falls back to OPENAI_BASE_URL;
# MODEL_API_KEY falls back to QWEN_API_KEY, then OPENAI_API_KEY.
MODEL_BASE_URL=https://token-plan.maas.qianwenaiapi.com/compatible-mode/v1
MODEL_NAME=qwen3.8-flash
MODEL_API_KEY=

# Failure analysis (evidence-first forensic agent, read-only)
# Enabled by default; requires a model API key (MODEL_API_KEY, falling back to
# QWEN_API_KEY then OPENAI_API_KEY) and is always disabled in CONSOLE_DEMO=1
# (the scripted demo model cannot submit a valid forensic result).
CONSOLE_ANALYSIS_ENABLED=true
# Retention for investigation metadata in SQLite (days, minimum 1)
CONSOLE_ANALYSIS_RETENTION_DAYS=30
# Analysis starts per minute (token bucket, minimum 1)
CONSOLE_ANALYSIS_RATE_PER_MIN=10
# Per-analysis deadline in seconds (minimum 1)
CONSOLE_ANALYSIS_TIMEOUT_SECONDS=60
# Server-enforced drill-down budget per analysis (minimum 1)
CONSOLE_ANALYSIS_MAX_TOOL_CALLS=6
