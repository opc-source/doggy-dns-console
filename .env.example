# Console
CONSOLE_ADDR=127.0.0.1:8787
CONSOLE_DB=sqlite:data/console.db
CONSOLE_APP_NAME=doggy-dns-console
CONSOLE_USER_ID=local
# 1 = fixture data + scripted model, no external services
CONSOLE_DEMO=0

# OpenObserve REST (dashboard)
OPENOBSERVE_BASE_URL=http://127.0.0.1:5080
OPENOBSERVE_ORG=default
OPENOBSERVE_USER=root@example.com
OPENOBSERVE_PASSWORD=change-me
# Optional bearer token; takes precedence over basic auth
OPENOBSERVE_TOKEN=
OPENOBSERVE_LOG_STREAM=doggy-dns
OPENOBSERVE_TRACE_STREAM=doggy-dns
OPENOBSERVE_METRIC_QUERIES=dns_queries_total
OPENOBSERVE_METRIC_DURATION=dns_query_duration_milliseconds_bucket

# OpenObserve MCP (AI raw drill-down, read-only allowlist)
OPENOBSERVE_MCP_URL=http://127.0.0.1:5080/api/default/mcp
OPENOBSERVE_MCP_TOKEN=

# doggy-dns MCP endpoints (comma separated, one per instance)
MCP_ENDPOINTS=
MCP_TOKEN=

# Model (OpenAI-compatible)
MODEL_BASE_URL=https://api.deepseek.com/v1
MODEL_NAME=deepseek-chat
MODEL_API_KEY=
